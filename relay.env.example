# Copy to relay.env next to compose.yml. Keep it private.

# Signs the credentials the relay hands to Spark servers. Generate once:
#   openssl rand -base64 48
# Changing it makes every Spark server register again (automatic).
CAPABILITY_SECRET=

# Pangolin's proxy appends the caller's address to X-Forwarded-For.
TRUST_PROXY=true

# Optional: only these addresses may register a Spark server (your home IP).
# REGISTER_ALLOWED_CIDRS=203.0.113.7/32

# Official Silo apps: their Apple pushes go on to the official Silo relay.
FORWARD_RELAY_URL=https://push.siloserver.org
FORWARD_APNS_TOPICS=org.siloserver.silo

# Spark apps on iPhone, iPad, Apple TV and Mac: an APNs auth key (.p8) from the
# paid Apple Developer account that signs the Spark apps.
# APNS_KEY_FILE=/secrets/AuthKey_XXXXXXXXXX.p8
# APNS_KEY_ID=XXXXXXXXXX
# APNS_TEAM_ID=XXXXXXXXXX
# APNS_TOPICS=com.joloxx9.spark

# Spark app on Android: the service account key of the Firebase project that
# holds the Spark Android app (Project settings > Service accounts).
# FCM_SERVICE_ACCOUNT_FILE=/secrets/firebase-service-account.json

# Text shown when the app cannot fetch the notification from its server.
ALERT_TITLE=Spark
ALERT_BODY=You have a new notification.
